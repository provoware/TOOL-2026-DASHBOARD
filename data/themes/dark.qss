QWidget {
    background-color: #1e1e1e;
    color: #f0f0f0;
}

#header {
    background-color: #2c2f33;
    padding: 6px;
    font-weight: bold;
}

#sidebar {
    background-color: #1b1f23;
    border-right: 2px solid #e65c00;
}

#right_panel {
    background-color: #1b1f23;
    border-left: 2px solid #5e35b1;
}

QWidget#card1,
QWidget#card2,
QWidget#card3,
QWidget#card4,
QWidget#card5,
QWidget#card6,
QWidget#card7,
QWidget#card8,
QWidget#card9 {
    background-color: #262829;
    border-radius: 6px;
}

QPushButton {
    background-color: #333333;
    color: #ffffff;
    border: 1px solid #555555;
    padding: 4px 8px;
}

QPushButton:hover {
    background-color: #555555;
}

#statusbar {
    background-color: #2c2f33;
    color: #f0f0f0;
}
